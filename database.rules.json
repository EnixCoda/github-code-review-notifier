{
  "rules": {
    "registered": {
      ".read": true,
      ".write": true,
      ".indexOn": ["botToken", "botID", "accessToken"]
    },
    "link": {
      ".read": true,
      ".write": true,
      ".indexOn": ["github", "slack"]
    },
    "metrics": {
      ".read": true,
      ".write": true
    },
    "usage": {
      ".read": true,
      ".write": true
    },
    "logs": {
      ".read": false,
      ".write": false
    },
    ".read": false,
    ".write": false
  }
}
